<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{pageTitle}}</title>

  <link rel="stylesheet" href="/assets/css/core.css" />
  <link rel="stylesheet" href="/assets/css/layout.css" />
  <link rel="stylesheet" href="/assets/css/components.css" />
  <link rel="stylesheet" href="/assets/css/modules/clients.css" />
  <link rel="stylesheet" href="/assets/css/pages/dashboard.css" />
</head>

<body
  class="{{bodyClass}}"
  data-required-role="{{requiredRole}}"
  data-entry-page="{{entryPage}}"
>
  <header class="dashboard-topbar">
    <div class="dashboard-brand">
      <img src="/img/logo.png" alt="CRM BESTPC" class="dashboard-logo" />

      <div class="dashboard-brand-copy">
        <h1>Manager UK</h1>
        <p id="panelSubtitle">Dashboard único</p>
      </div>
    </div>

    <div class="dashboard-session">
      <span id="roleBadge" class="role-badge">ROL</span>

      <div class="dashboard-user-box">
        <span class="dashboard-user-label">Usuario actual</span>
        <strong id="sessionUserText">Cargando...</strong>
      </div>

      <button id="logoutBtn" class="btn btn-outline" type="button">
        Salir
      </button>
    </div>
  </header>

  <main class="dashboard-shell">
    <section class="dashboard-hero card">
      <div class="dashboard-hero-main">
        <h2 id="panelTitle">Cargando dashboard...</h2>
        <p id="panelDescription" class="muted">
        </p>
      </div>
        <div class="hero-stat">
          <span class="hero-stat-label">Estado</span>
          <strong id="sessionStateText">Validando¿?</strong>
        </div>
      </div>
    </section>
    <!-- =====================================================
         BARRA DE MODULOS
    ====================================================== -->
    <section class="card">
      <div class="section-head">
        <h3>Módulos del rol</h3>
      </div>

      <div id="dashboardTabs" class="dashboard-tabs"></div>
    </section>

    <section id="dashboardAlert" class="dashboard-alert hidden"></section>

    <!-- =====================================================
         CLIENTES REALES
    ====================================================== -->
<section id="clientsSection" class="card dashboard-section hidden"> <div class="section-head section-head-inline clients-head"> <div class="clients-head-copy"> <h3>Clientes</h3> <p class="muted" id="clientsMsg">Cargando...</p> </div> <div class="clients-toolbar-shell"> <div class="toolbar wrap clients-toolbar-actions"> <button id="reloadClients" class="btn btn-outline" type="button"> Recargar </button> <button id="createClient" class="btn btn-primary" type="button"> Crear cliente </button> </div> <div class="clients-toolbar-tools"> <div class="clients-search-wrap"> <input id="clientsSearch" class="clients-search-input" type="text" placeholder="Buscar por nombre, apellido, DNI, asignado..." autocomplete="off" /> </div> <div class="clients-toolbar-bottom"> 
  <select id="clientsPageSize" class="clients-page-size"> 
  <option value="10" selected>10 por página</option> 
  <option value="20">20 por página</option> 
  <option value="50">50 por página</option> 
  </select> 
  <div class="clients-pagination-box"> <button id="clientsPrevPage" class="btn btn-outline clients-page-btn" type="button"> ← </button> <span id="clientsPageIndicator" class="clients-page-indicator"> Página 1 de 1 </span> <button id="clientsNextPage" class="btn btn-outline clients-page-btn" type="button"> → </button> </div> </div> </div> </div> </div> <div class="table-wrap"> <table class="table"> <thead> <tr> <th>ID</th> <th>Nombres</th> <th>Apellidos</th> <th>DNI</th> <th id="assignedHead">Asignado a</th> <th>Seguimiento</th> <th>Observaciones</th> <th>Simulación</th> <th id="blacklistHead">Lista negra</th> <th>Acciones</th> </tr> </thead> <tbody id="clientsBody"></tbody> </table> </div> </section>

    <!-- =====================================================
         PLACEHOLDERS RESTANTES
    ====================================================== -->
    <section id="usersSection" class="card dashboard-section hidden">
      <div class="section-head">
        <h3>Usuarios</h3>
        <p class="muted">Pendiente de conectar.</p>
      </div>

      <div class="placeholder-box">
        <p class="placeholder-title">Módulo pendiente</p>
        <p class="placeholder-text">La siguiente conexión real será usuarios.</p>
      </div>
    </section>

    <section id="createUserSection" class="card dashboard-section hidden">
      <div class="section-head">
        <h3>Crear usuario</h3>
        <p class="muted">Pendiente de conectar.</p>
      </div>

      <div class="placeholder-box">
        <p class="placeholder-title">Formulario pendiente</p>
        <p class="placeholder-text">Primero consolidamos clientes y luego creación de usuarios.</p>
      </div>
    </section>

    <section id="importSection" class="card dashboard-section hidden">
      <div class="section-head">
        <h3>Importación</h3>
        <p class="muted">Pendiente de conectar.</p>
      </div>

      <div class="placeholder-box">
        <p class="placeholder-title">Módulo pendiente</p>
        <p class="placeholder-text">Aquí irá carga masiva / Excel.</p>
      </div>
    </section>
  </main>

  <!-- =====================================================
       OVERLAY GLOBAL DE MODALES
  ====================================================== -->
  <div id="modalOverlay" class="modal-overlay hidden"></div>

  <!-- =====================================================
       MODAL DE CLIENTE
  ====================================================== -->
  <section id="clientModal" class="modal hidden">
    <div class="modal-card">
      <div class="section-head section-head-inline">
        <div>
          <h3 id="clientModalTitle">Crear cliente</h3>
          <p class="muted" id="clientModalSubtitle">Completa los datos necesarios.</p>
        </div>

        <button id="clientModalClose" class="btn btn-outline" type="button">Cerrar</button>
      </div>

      <form id="clientForm" class="form-grid">
        <input id="clientId" type="hidden" />

        <div class="form-row">
          <label for="cf_nombres">Nombres</label>
          <input id="cf_nombres" type="text" placeholder="Nombres" />
        </div>

        <div class="form-row">
          <label for="cf_apellidos">Apellidos</label>
          <input id="cf_apellidos" type="text" placeholder="Apellidos" />
        </div>

        <div class="form-row">
          <label for="cf_dni">DNI</label>
          <input id="cf_dni" type="text" placeholder="0102030405" />
        </div>

        <div class="form-row">
          <label for="cf_metodoPago">Método de pago</label>
          <input id="cf_metodoPago" type="text" placeholder="Cuotitas / Contado / Tarjeta" />
        </div>

        <div class="form-row">
          <label for="cf_metodoSeguimiento">Método de seguimiento</label>
          <input id="cf_metodoSeguimiento" type="text" placeholder="WhatsApp / Llamada" />
        </div>

        <div class="form-row form-row-full">
          <label for="cf_observaciones">Observaciones</label>
          <textarea id="cf_observaciones" rows="4"></textarea>
        </div>

        <div class="form-row checkbox-row">
          <label class="checkbox-inline">
            <input id="cf_simulacion" type="checkbox" />
            <span>Simulación</span>
          </label>
        </div>

        <div class="form-row checkbox-row" id="row_listaNegra">
          <label class="checkbox-inline">
            <input id="cf_listaNegra" type="checkbox" />
            <span>Lista negra</span>
          </label>
        </div>

        <div class="form-row" id="row_asignadoA">
          <label for="cf_asignadoA">Asignado a</label>
          <select id="cf_asignadoA"></select>
        </div>

        <p id="clientFormError" class="error"></p>

        <div class="toolbar wrap">
          <button id="clientCancelBtn" class="btn btn-outline" type="button">Cancelar</button>
          <button id="clientSaveBtn" class="btn btn-primary" type="submit">Guardar</button>
        </div>
      </form>
    </div>
  </section>

  <!-- =====================================================
       MODAL DE SEGUIMIENTOS
  ====================================================== -->
  <section id="followUpModal" class="modal hidden">
    <div class="modal-card modal-card-lg">
      <div class="section-head section-head-inline">
        <div>
          <h3 id="followUpModalTitle">Seguimientos del cliente</h3>
          <p class="muted" id="followUpClientInfo">Cliente seleccionado</p>
        </div>

        <div class="toolbar wrap">
          <button id="openFollowUpFormBtn" class="btn btn-primary" type="button">Nuevo seguimiento</button>
          <button id="followUpModalClose" class="btn btn-outline" type="button">Cerrar</button>
        </div>
      </div>

      <div id="followUpListView">
        <p id="followUpMsg" class="muted">Cargando seguimientos...</p>

        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Fecha</th>
                <th>Número cliente</th>
                <th>Origen</th>
                <th>Método pago</th>
                <th>Insistencia</th>
                <th>Simulación</th>
                <th>Resolución</th>
                <th>Facturado</th>
                <th>Despachado</th>
                <th>Observaciones</th>
              </tr>
            </thead>
            <tbody id="followUpBody"></tbody>
          </table>
        </div>
      </div>

      <div id="followUpFormView" class="hidden">
        <form id="followUpForm" class="form-grid">
          <input id="fu_clientId" type="hidden" />
          <input id="fu_id" type="hidden" />

          <div class="form-row">
            <label for="fu_fecha">Fecha</label>
            <input id="fu_fecha" type="date" />
          </div>

          <div class="form-row">
            <label for="fu_numeroCliente">Número del cliente</label>
            <input id="fu_numeroCliente" type="text" />
          </div>

          <div class="form-row"><label for="fu_origen">Origen</label><select id="fu_origen"></select></div>
          <div class="form-row"><label for="fu_metodoPago">Método de pago</label><select id="fu_metodoPago"></select></div>
          <div class="form-row"><label for="fu_insistencia">Insistencia</label><select id="fu_insistencia"></select></div>
          <div class="form-row"><label for="fu_simulacion">Simulación</label><select id="fu_simulacion"></select></div>
          <div class="form-row"><label for="fu_tipoCliente">Tipo de cliente</label><select id="fu_tipoCliente"></select></div>
          <div class="form-row"><label for="fu_resolucion">Resolución</label><select id="fu_resolucion"></select></div>
          <div class="form-row"><label for="fu_documentacion">Documentación</label><select id="fu_documentacion"></select></div>
          <div class="form-row"><label for="fu_referencias">Referencias</label><select id="fu_referencias"></select></div>
          <div class="form-row"><label for="fu_verificacionIdentidad">Verificación identidad</label><select id="fu_verificacionIdentidad"></select></div>
          <div class="form-row"><label for="fu_facturado">Facturado</label><select id="fu_facturado"></select></div>
          <div class="form-row"><label for="fu_despachado">Despachado</label><select id="fu_despachado"></select></div>

          <div class="form-row form-row-full">
            <label for="fu_observaciones">Observaciones</label>
            <textarea id="fu_observaciones" rows="4"></textarea>
          </div>

          <p id="followUpFormError" class="error"></p>

          <div class="toolbar wrap">
            <button id="followUpBackBtn" class="btn btn-outline" type="button">Volver</button>
            <button id="followUpSaveBtn" class="btn btn-primary" type="submit">Guardar seguimiento</button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <script type="module" src="/assets/js/pages/dashboard.js"></script>
</body>
</html>