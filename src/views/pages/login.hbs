<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{pageTitle}}</title>

  <!--
    =========================================================
    ASSETS ESTÁTICOS
    ---------------------------------------------------------
    OJO:
    public/ se sirve desde la raíz web.
    Por eso NO se usa /public/assets/...
    Se usa /assets/...
    =========================================================
  -->
  <link rel="stylesheet" href="/assets/css/core.css" />
  <link rel="stylesheet" href="/assets/css/layout.css" />
  <link rel="stylesheet" href="/assets/css/components.css" />
  <link rel="stylesheet" href="/assets/css/pages/login.css" />
</head>

<body class="{{bodyClass}}">
  <main class="login-shell">
    <section class="login-card">
      <div class="login-head">
        <h1>CRM BESTPC</h1>
        <p>Inicia sesión para acceder al sistema</p>
      </div>

      <form id="loginForm" class="form-grid" autocomplete="on" novalidate>
        <div class="form-row">
          <label for="email">Correo</label>
          <input
            id="email"
            name="email"
            type="email"
            placeholder="admin@test.com"
            autocomplete="username"
            required
          />
        </div>

        <div class="form-row">
          <label for="password">Contraseña</label>
          <input
            id="password"
            name="password"
            type="password"
            placeholder="••••••••"
            autocomplete="current-password"
            required
          />
        </div>

        <p id="loginMessage" class="error-box"></p>

        <div class="form-actions">
          <button id="loginSubmitBtn" class="btn btn-primary" type="submit">
            Ingresar
          </button>
        </div>
      </form>
    </section>
  </main>

  <!--
    =========================================================
    LOGIN AUTOSUFICIENTE
    ---------------------------------------------------------
    Sin imports.
    Sin módulos.
    Sin dependencias cruzadas.
    Primero que funcione; luego lo modularizamos.
    =========================================================
  -->
  <script src="/assets/js/pages/login.js"></script>
</body>
</html>